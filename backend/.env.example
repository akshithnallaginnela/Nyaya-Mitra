# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/nyaya_mitra

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
AI_PROVIDER=ollama # choices: ollama, bedrock
VECTOR_DB_TYPE=chroma # choices: chroma, opensearch

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Amazon Bedrock Configuration (AWS)
# Note: Requires AWS credentials configured with Bedrock access
AWS_REGION=us-east-1
